NODE_ENV=development
PORT=8080
API_HOST=0.0.0.0
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_client_id
DISCORD_CLIENT_SECRET=replace_with_client_secret
DISCORD_REDIRECT_URI=https://dashboard.example.com/auth/discord/callback
JWT_ACCESS_SECRET=replace_with_very_long_access_secret_32_chars_min
JWT_REFRESH_SECRET=replace_with_very_long_refresh_secret_32_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
DATABASE_URL=postgresql://shield:shield_password@postgres:5432/discord_shield
REDIS_URL=redis://redis:6379
WS_ALLOWED_ORIGINS=https://dashboard.example.com
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
SHARD_COUNT=4
SHARD_ID=0
METRICS_ENABLED=true
