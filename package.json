{
  "name": "discord-shield-security-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "migrate": "node dist/src/infrastructure/db/migrate.js",
    "worker": "node dist/src/workers/main.js",
    "bot": "node dist/src/bot/main.js",
    "verify:deps": "node scripts/verify-deps.mjs",
    "postinstall": "npm run verify:deps",
    "install:direct": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u npm_config_http_proxy -u npm_config_https_proxy npm install",
    "check:direct": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u npm_config_http_proxy -u npm_config_https_proxy npm run check"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "bullmq": "^5.7.8",
    "discord.js": "14.25.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10"
  },
  "overrides": {
    "discord.js": "14.25.1",
    "@discordjs/builders": "^1.10.1",
    "@discordjs/collection": "^2.1.1"
  }
}
